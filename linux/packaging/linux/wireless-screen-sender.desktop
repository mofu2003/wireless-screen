[Desktop Entry]
Type=Application
Name=WirelessScreen Sender
Name[zh_CN]=无线副屏发送端
Comment=Extend or mirror this Linux desktop to a Mac or Android device
Comment[zh_CN]=将这台 Linux 桌面扩展或镜像到 Mac、Android 设备
Exec=/usr/bin/wireless-screen-sender run
Icon=wireless-screen-sender
Terminal=true
Categories=Utility;
Keywords=wireless;display;screen;mirror;extend;receiver;monitor;
# KWin < 6.8 grants these globals only to the exact program named here.
X-KDE-Wayland-Interfaces=zkde_screencast_unstable_v1,org_kde_kwin_fake_input
