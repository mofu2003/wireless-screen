[Desktop Entry]
Type=Application
Name=无线副屏接收端
Name[en]=WirelessScreen Receiver
Comment=把这块屏幕作为 Mac 的无线副屏
Comment[en]=Use this screen as a wireless display for a Mac
Exec=/usr/bin/wireless-screen-receiver
Icon=wireless-screen-receiver
Terminal=false
Categories=Utility;
Keywords=display;sidecar;screen;second;monitor;wireless;
StartupWMClass=io.github.mofu2003.wirelessscreen.receiver
